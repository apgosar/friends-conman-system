# On-prem environment template. Copy to deploy/onprem/.env and fill in real
# values on the customer's server — never commit the filled-in file.
#
# Secrets here (DB password, MinIO keys, NEXTAUTH_SECRET, CRON_SECRET)
# must be generated fresh per deployment — never reused across customers.

# ── Deployment target ──────────────────────────────────────────
DEPLOYMENT_TARGET="onprem"
STORAGE_PROVIDER="s3"

# ── Image ────────────────────────────────────────────────────
# The exact released version this customer is pinned to. Never "latest" —
# promote deliberately by editing this and re-running `docker compose pull`.
# Tags are cut by pushing a git tag (see .github/workflows/release-onprem.yml),
# e.g. `git tag v1.2.0 && git push origin v1.2.0`.
IMAGE_TAG="v1.0.0"

# ── License gate ──────────────────────────────────────────────
# "onprem" enforces the license check in src/proxy.ts; unset/anything else
# never enforces (matches cloud behavior). Issue the token on your own
# machine with scripts/license/issue-license.ts — never on the customer's
# server — and paste its contents below.
# Testing locally before you have a domain/license issued? Set this to ""
# to bypass the gate entirely, same as cloud. Put it back to "onprem" with
# a real LICENSE_TOKEN before this goes anywhere near a real customer.
LICENSE_MODE="onprem"
LICENSE_TOKEN="CHANGE_ME_paste_the_output_of_scripts_license_issue-license_ts"

# ── Database (local Postgres container, service name `db` in docker-compose.yml) ──
POSTGRES_DB="neev_cms"
POSTGRES_USER="neev_cms"
POSTGRES_PASSWORD="CHANGE_ME_generate_a_strong_password"
DATABASE_URL="postgresql://neev_cms:CHANGE_ME_generate_a_strong_password@db:5432/neev_cms?schema=public"

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# NextAuth parses this with `new URL(...)` at runtime — it MUST be a real,
# syntactically valid URL, not a literal "<...>" placeholder, or you'll hit
# a cryptic "Invalid URL" crash with no indication of where it came from.
# Defaults below match docker-compose.override.yml.example for local
# testing (see README.md "Test locally before wiring up internet access").
# Before going live with a real customer, change both to
# "https://<customer-slug>.<your-domain>" — see README.md for what those
# two placeholders mean.
NEXTAUTH_URL="http://localhost:8080"
APP_URL="http://localhost:8080"

# ── Object storage (local MinIO container, service name `minio`) ───────────
AWS_ACCESS_KEY_ID="CHANGE_ME_minio_root_user"
AWS_SECRET_ACCESS_KEY="CHANGE_ME_minio_root_password_min_8_chars"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="neev-cms-docs"
S3_ENDPOINT="http://minio:9000"
S3_FORCE_PATH_STYLE="true"

# ── Company details ─────────────────────────────────────────────
COMPANY_NAME="Customer Company Name"
COMPANY_ADDRESS="Customer Company Address"
COMPANY_GSTIN=""

# ── Email (Gmail App Password, or generic SMTP — see .env.example) ─────────
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Cron job security ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
