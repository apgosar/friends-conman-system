# ============================================================
# .env.production.example
# Copy this file to .env.production and fill in your values
# before running ./deploy-cloudrun.ps1
# ============================================================

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Use the Supabase Transaction Pooler URL (port 6543) or Session Pooler (port 5432)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.your-supabase-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── NextAuth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 (or let deploy script generate one)
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Set to your Cloud Run URL or custom domain (e.g., https://neev-cms-xyz.a.run.app)
NEXTAUTH_URL="https://neev-cms-your-hash-el.a.run.app"

# ── App ─────────────────────────────────────────────────────
APP_URL="https://neev-cms-your-hash-el.a.run.app"
COMPANY_NAME="Paradigm Friends Realtors LLP"
COMPANY_ADDRESS="Mumbai, Maharashtra"
COMPANY_GSTIN=""

# ── Google Cloud Storage (GCS) ──────────────────────────────
# Name of the GCS bucket created for file uploads (e.g. neev-cms-docs)
GCS_BUCKET_NAME="neev-cms-docs"

# ── Email (Gmail App Password or SMTP) ───────────────────────
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# ── WhatsApp Business Cloud API (Meta) ──────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
NEXT_PUBLIC_WHATSAPP_CONFIGURED="false"

# ── KYC / OCR Integration ────────────────────────────────────
AZAPI_TOKEN=""
SUREPASS_TOKEN=""

# ── Cron Job Security ────────────────────────────────────────
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ── Personal data ───────────────────────────────────────────
# Encrypts buyers' PAN and Aadhaar numbers in the database. 32 random bytes, base64:  openssl rand -base64 32
# REQUIRED in production. Back it up apart from the database: without it those numbers cannot be read again.
# After setting it on an existing database, run once:  npm run db:encrypt-pii
PII_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ── Sentry Error Tracking (Optional) ─────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
