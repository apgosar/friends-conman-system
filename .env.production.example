# ============================================================
# .env.production.example
# The Google Cloud stack: Cloud Run + Cloud SQL + Cloud Storage + Vertex AI (Gemini).
# Copy this file to .env.production and fill in your values before running ./deploy-cloudrun.ps1
#
# deploy-cloudrun.ps1 creates and wires these for you, so they are NOT in this file:
#   DATABASE_URL (Cloud SQL, kept in Secret Manager), NEXTAUTH_SECRET, CRON_SECRET,
#   GCS_BUCKET_NAME, GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION, NEXTAUTH_URL, APP_URL.
# ============================================================

# ── Company ─────────────────────────────────────────────────
COMPANY_NAME="Paradigm Friends Realtors LLP"
COMPANY_ADDRESS="Mumbai, Maharashtra"
COMPANY_GSTIN=""

# ── Personal data ───────────────────────────────────────────
# Encrypts buyers' PAN and Aadhaar numbers in the database. 32 random bytes, base64:  openssl rand -base64 32
# REQUIRED. The deploy script keeps it in Secret Manager and NEVER replaces it once it is there: a new key would make
# every stored PAN and Aadhaar unreadable. Back it up apart from the database.
PII_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ── Google AI (Gemini on Vertex AI) ─────────────────────────
# Optional overrides. No API key is needed: the Cloud Run service account is allowed to call Vertex AI.
# GOOGLE_CLOUD_LOCATION="asia-south1"
# GEMINI_MODEL="gemini-3.5-flash"

# ── Demo access (a deployment for judges or trials only) ─────
# The sign-in page fills these in for EVERY visitor. Use an Admin account made for it (not a Super Admin), a password used
# nowhere else, and made-up data. The password is kept in Secret Manager. Leave both out for a real customer.
# DEMO_LOGIN_EMAIL="judge@example.com"
# DEMO_LOGIN_PASSWORD=""

# ── Email (Gmail App Password or SMTP) ───────────────────────
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# ── WhatsApp Business Cloud API (Meta) ──────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
NEXT_PUBLIC_WHATSAPP_CONFIGURED="false"

# ── Sentry Error Tracking (Optional) ─────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
