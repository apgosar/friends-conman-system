# ============================================================
# .env.example — Copy this to .env.local and fill in values
# NEVER commit actual secrets to version control
# ============================================================

# ── Database ────────────────────────────────────────────────
# For local dev (SQLite):
DATABASE_URL="file:../prisma/dev.db"
# For production (PostgreSQL):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/friends_conman?schema=public"

# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3001"

# ── App ─────────────────────────────────────────────────────
APP_URL="http://localhost:3001"
COMPANY_NAME="Your Company Name"
COMPANY_ADDRESS="Your Company Address"
COMPANY_GSTIN=""

# ── Deployment target ─────────────────────────────────────────
# "cloud" (default) or "onprem" — see DEPLOYMENT_ONPREM.md.
# Picks sane per-target defaults (e.g. storage provider) in deployment-config.ts.
DEPLOYMENT_TARGET="cloud"

# ── Document storage ──────────────────────────────────────────
# "gcs" or "s3". Defaults to gcs for cloud, s3 for onprem — set explicitly to override.
STORAGE_PROVIDER=""

# GCS (used when STORAGE_PROVIDER=gcs)
GCS_BUCKET_NAME="friends-conman-docs"

# S3 / MinIO (used when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your-bucket-name"
# Leave S3_ENDPOINT unset to talk to real AWS S3. For on-prem MinIO, point it
# at the MinIO container (e.g. "http://minio:9000") and set S3_FORCE_PATH_STYLE.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# ── Email (Gmail App Password) ───────────────────────────────
# 1. Enable 2FA on your Gmail account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate a password for this app and paste below
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
# OR use generic SMTP:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your@email.com"
# SMTP_PASS="your-password"
# SMTP_FROM_ADDRESS="Your Company <your@email.com>"

# ── WhatsApp Business Cloud API (Meta) ──────────────────────
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
NEXT_PUBLIC_WHATSAPP_CONFIGURED="false"

# ── Financial Defaults ───────────────────────────────────────
INTEREST_RATE_PA=12
TDS_THRESHOLD=5000000
GST_RATE=5

# ── KYC / OCR Integration ────────────────────────────────────
# AZAPI token for PAN/Aadhaar OCR (https://azapi.ai)
AZAPI_TOKEN=""
# SurePass token for identity verification
SUREPASS_TOKEN=""

# ── Cron Job Security ────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Used as: Authorization: Bearer YOUR_CRON_SECRET
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
