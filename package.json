{
  "name": "friends-conman-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "worker": "npx tsx src/scripts/process-email-queue.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:encrypt-pii": "tsx scripts/encrypt-pii.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "lint:ci": "eslint src tests --max-warnings 117"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google-cloud/storage": "^8.0.0",
    "@prisma/client": "^6.4.1",
    "@sentry/nextjs": "^10.76.2",
    "bcryptjs": "^3.0.3",
    "docx": "^9.10.0",
    "docx-preview": "^0.3.7",
    "docxtemplater": "^3.69.0",
    "exceljs": "^4.4.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pizzip": "^3.2.0",
    "prisma": "^6.4.1",
    "puppeteer": "^25.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pizzip": "^3.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
