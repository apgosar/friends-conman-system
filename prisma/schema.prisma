generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role String @default("VIEWER")
  isActive      Boolean   @default(true)
  tokenVersion  Int       @default(0) // bumped on password change / deactivation / role change: invalidates every open session
  passwordChangedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  auditLogs     AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// INQUIRY (Quotes generated for Units)
// ─────────────────────────────────────────────

model Inquiry {
  id              String   @id @default(cuid())
  unitId          String
  customerName    String
  mobileNumber    String
  agreementValue  Decimal @db.Decimal(15, 2)
  parkingIncluded Boolean  @default(false)
  stampDuty       Decimal @db.Decimal(15, 2)
  gst             Decimal @db.Decimal(15, 2)
  registration    Decimal @db.Decimal(15, 2)
  totalCost       Decimal @db.Decimal(15, 2)
  email           String?
  source          String?  // WALK_IN | REFERRAL | WEBSITE | BROKER | OTHER
  sourceDetail    String?  // referrer / broker name
  validUntil      DateTime? // quote expiry
  status          String   @default("OPEN") // OPEN | CONVERTED | LOST
  convertedSaleId String?  // set when the inquiry is converted into a sale
  lostReason      String?
  lostNote        String?
  lastSharedAt    DateTime?
  lastSharedVia   String?  // EMAIL | WHATSAPP | EMAIL+WHATSAPP
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("inquiries")
}

// ─────────────────────────────────────────────
// PROJECT
// ─────────────────────────────────────────────

model Project {
  id                  String          @id @default(cuid())
  name                String
  reraNumber          String?
  address             String
  city                String
  state               String          @default("Maharashtra")
  type String @default("FRESH")
  status String @default("PLANNING")
  launchDate          DateTime?
  expectedCompletion  DateTime?
  companyName         String
  companyAddress      String
  companyGstin        String?
  stampDutyPercent    Float         @default(6)
  regChargesPercent   Float         @default(1) 
  regChargesCap       Decimal?        @db.Decimal(15, 2) @default(30000) // registration fee is regChargesPercent of the agreement value, but never more than this (empty = no cap)
  regParkingCharges   Decimal         @db.Decimal(15, 2) @default(20000) // extra registration fee when a car park is included
  gstRatePercent      Float         @default(5)
  tdsRatePercent      Float         @default(1)
  interestRatePercent Float         @default(12) // simple interest per annum on overdue demands
  carParkingCharges   Decimal @db.Decimal(15, 2)         @default(500000)  // Default car parking price from project template
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  wings               Wing[]
  unitTypes           UnitType[]
  milestones          ConstructionMilestone[]
  templates           Template[]
  tenants             Tenant[]
  sales               Sale[]
  auditLogs           AuditLog[]

  @@map("projects")
}





model Wing {
  id          String  @id @default(cuid())
  projectId   String
  name        String  // A, B, Tower 1
  totalFloors Int
  createdAt   DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors      Floor[]

  @@index([projectId])
  @@map("wings")
}

model Floor {
  id              String  @id @default(cuid())
  wingId          String
  floorNumber     Int
  floorPlanUrl    String?
  createdAt       DateTime @default(now())

  wing            Wing    @relation(fields: [wingId], references: [id], onDelete: Cascade)
  units           Unit[]

  @@index([wingId])
  @@map("floors")
}

/// A repeating layout in a project (e.g. "2BHK-A"): defined once, used by many units.
model UnitType {
  id               String   @id @default(cuid())
  projectId        String
  category         String   @default("FLAT") // FLAT | SHOP | OFFICE
  name             String   // 2BHK-A, Shop, Penthouse
  configuration    String   // 1BHK, 2BHK, 3BHK, Shop...
  carpetAreaSqft   Float
  builtupAreaSqft  Float?
  basePricePerSqft Float?
  floorPlanUrl     String?  // storage URL of the floor plan image
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units            Unit[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("unit_types")
}

model Unit {
  id                  String      @id @default(cuid())
  floorId             String
  unitTypeId          String?     // layout this unit follows (shared floor plan, area, price)
  category            String      @default("FLAT") // FLAT | SHOP | OFFICE
  unitNumber          String      // A-301
  configuration       String      // 1BHK, 2BHK, 3BHK
  carpetAreaSqft      Float     
  builtupAreaSqft     Float?    
  basePricePerSqft    Float?    
  status String @default("AVAILABLE")
  statusManual        Boolean     @default(false) // status set by hand (unit sold before the system was used), not derived from a sale
  bookedByName        String?     // who booked it, for a unit marked Booked by hand (no sale record)
  bookedByMobile      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  floor               Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitType            UnitType?   @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  sales               Sale[]
  inquiries           Inquiry[]
  tenant              Tenant?

  @@index([floorId])
  @@index([unitTypeId])
  @@index([status])
  @@map("units")
}



// ─────────────────────────────────────────────
// TENANT (Redevelopment)
// ─────────────────────────────────────────────

model Tenant {
  id                  String    @id @default(cuid())
  projectId           String
  newUnitId           String?   @unique
  name                String
  oldFlatNumber       String
  oldAreaSqft         Float   
  extraAreaSqft       Float   @default(0) 
  whatsappNumber      String?
  email               String?
  receiveComms        Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  newUnit             Unit?     @relation(fields: [newUnitId], references: [id])
  sale                Sale?

  @@index([projectId])
  @@map("tenants")
}

// ─────────────────────────────────────────────
// SALE
// ─────────────────────────────────────────────

model Sale {
  id                    String      @id @default(cuid())
  saleNumber            String      @unique // PRJ-001
  projectId             String
  unitId                String
  tenantId              String?     @unique
  saleType              String      @default("FRESH")
  agreementValue        Decimal @db.Decimal(15, 2)     
  gstAmount             Decimal @db.Decimal(15, 2)      // 5% of agreementValue
  stampDuty             Decimal? @db.Decimal(15, 2)    
  registrationCharges   Decimal? @db.Decimal(15, 2)    
  carParking            Boolean     @default(false)
  carParkingCharges     Decimal? @db.Decimal(15, 2)      // Actual car parking amount charged
  parkingPodiumLevel    String?
  parkingFloor          String?
  parkingNumber         String?
  bookingAmount         Decimal? @db.Decimal(15, 2)      // Custom booking amount received
  bookingDate           DateTime
  agreementDate         DateTime?
  possessionDate        DateTime?
  status                String      @default("BOOKED")
  nameChangeHistory     Json?       // array of {oldName, newName, date, userId}
  deletedAt             DateTime?   // Soft delete — null means active
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  project               Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unit                  Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  buyers                Buyer[]
  paymentSchedules      PaymentSchedule[]
  payments              Payment[]
  documents             Document[]
  communicationLogs     CommunicationLog[]
  loans                 Loan[]

  @@index([projectId])
  @@index([unitId])
  @@index([status])
  @@index([deletedAt])
  @@map("sales")
}





// ─────────────────────────────────────────────
// BUYER
// ─────────────────────────────────────────────

model Buyer {
  id                  String      @id @default(cuid())
  saleId              String
  fullName            String
  email               String?
  whatsappNumber      String?
  panNumber           String?
  aadhaarNumber       String?
  address             String?
  isPrimary           Boolean     @default(false)
  sequence            Int         @default(1)
  receiveComms        Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  sale                Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kycDocuments        KycDocument[]
  communicationLogs   CommunicationLog[]

  @@index([saleId])
  @@map("buyers")
}

model KycDocument {
  id              String        @id @default(cuid())
  buyerId         String
  docType String
  fileUrl         String
  status String @default("UPLOADED")
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  buyer           Buyer         @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([status])
  @@map("kyc_documents")
}





// ─────────────────────────────────────────────
// PAYMENT SCHEDULE & PAYMENTS
// ─────────────────────────────────────────────

model ConstructionMilestone {
  id                      String              @id @default(cuid())
  projectId               String
  name                    String              // Plinth Complete, 5th Slab
  sequence                Int
  percentOfAV             Float               @default(0)   // % of Agreement Value for payment plan
  plannedDate             DateTime?
  actualDate              DateTime?
  status String @default("UPCOMING")
  architectCertificateUrl String?
  completedAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  project                 Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentSchedules        PaymentSchedule[]

  @@index([projectId])
  @@map("construction_milestones")
}



model PaymentSchedule {
  id                      String          @id @default(cuid())
  saleId                  String
  milestoneId             String?
  description             String          // On Booking, On Plinth
  principalAmount         Decimal @db.Decimal(15, 2)         
  gstAmount               Decimal @db.Decimal(15, 2)         @default(0) 
  dueDate                 DateTime?
  demandGeneratedDate     DateTime?
  interestAmount          Decimal @db.Decimal(15, 2)         @default(0) 
  status String @default("UPCOMING")
  reminderCount           Int             @default(0)
  lastReminderAt          DateTime?
  managementEscalated     Boolean         @default(false)
  managementApprovedStern Boolean         @default(false)
  managementApprovedAt    DateTime?
  managementApprovedBy    String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  sale                    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  milestone               ConstructionMilestone? @relation(fields: [milestoneId], references: [id])
  payments                Payment[]

  @@index([saleId])
  @@index([status])
  @@index([status, dueDate])
  @@map("payment_schedules")
}



model Payment {
  id              String        @id @default(cuid())
  scheduleId      String
  saleId          String
  amount          Decimal @db.Decimal(15, 2)       
  gstPaid         Decimal @db.Decimal(15, 2)       @default(0) 
  mode String
  referenceNumber String?       // UTR, cheque number
  bankName        String?
  remark          String?
  paymentDate     DateTime
  clearedDate     DateTime?
  receiptNumber   String        @unique // RCP-PRJ-0001
  receiptPdfUrl   String?
  receiptSent     Boolean       @default(false)
  deletedAt       DateTime?     // Soft delete — null means active
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  schedule        PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  sale            Sale            @relation(fields: [saleId], references: [id])
  tdsRecord       TdsRecord?

  @@index([saleId])
  @@index([scheduleId])
  @@index([deletedAt])
  @@map("payments")
}



model TdsRecord {
  id                  String    @id @default(cuid())
  paymentId           String    @unique
  saleId              String
  tdsAmount           Decimal @db.Decimal(15, 2)    // 1% of payment
  form26QBAckNumber   String?
  tdsDepositedDate    DateTime?
  certificateUrl      String?
  status String @default("PENDING")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payment             Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("tds_records")
}



// ─────────────────────────────────────────────
// LOAN
// ─────────────────────────────────────────────

model Loan {
  id                  String      @id @default(cuid())
  saleId              String
  bankName            String
  sanctionedAmount    Decimal @db.Decimal(15, 2)     
  sanctionLetterUrl   String?
  totalDisbursed      Decimal @db.Decimal(15, 2)     @default(0) 
  status String @default("APPLIED")
  disbursements       LoanDisbursement[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  sale                Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("loans")
}



model LoanDisbursement {
  id          String    @id @default(cuid())
  loanId      String
  amount      Decimal @db.Decimal(15, 2)   
  date        DateTime
  referenceNo String?
  notes       String?
  createdAt   DateTime  @default(now())

  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("loan_disbursements")
}

// ─────────────────────────────────────────────
// TEMPLATES & DOCUMENTS
// ─────────────────────────────────────────────

model Template {
  id              String        @id @default(cuid())
  projectId       String
  type String
  name            String
  templateHtml    String?       @db.Text
  fileUrl         String?       // S3/Local URL for .docx templates
  version         Int           @default(1)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents       Document[]

  @@index([projectId])
  @@map("templates")
}



model Document {
  id              String        @id @default(cuid())
  saleId          String
  templateId      String?
  type String
  pdfUrl          String?
  status String @default("DRAFT")
  generatedAt     DateTime?
  sentAt          DateTime?
  deletedAt       DateTime?     // Soft delete — null means active
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  template        Template?     @relation(fields: [templateId], references: [id])
  communicationLogs CommunicationLog[]

  @@index([saleId])
  @@index([status])
  @@index([deletedAt])
  @@map("documents")
}





// ─────────────────────────────────────────────
// COMMUNICATION LOG
// ─────────────────────────────────────────────

model CommunicationLog {
  id                  String      @id @default(cuid())
  saleId              String
  buyerId             String?
  documentId          String?
  channel String
  type String
  messageContent      String?   @db.Text
  attachments         Json?       // [{ label, path }] documents to attach; path is an app-relative /api/... URL
  status String @default("QUEUED")
  providerMessageId   String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failureReason       String?
  retryCount          Int         @default(0)
  claimedAt           DateTime?   // set while a dispatcher worker owns the row (status SENDING)
  createdAt           DateTime    @default(now())

  sale                Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  buyer               Buyer?      @relation(fields: [buyerId], references: [id])
  document            Document?   @relation(fields: [documentId], references: [id])

  @@index([saleId])
  @@index([status])
  @@index([status, retryCount])
  @@map("communication_logs")
}







// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  projectId   String?
  entityType  String    // sale, payment, document, unit...
  entityId    String
  action      String    // created, updated, deleted, sent, generated, verified
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}


// ─────────────────────────────────────────────
// INFRASTRUCTURE
// ─────────────────────────────────────────────

/// Gap-free counters for sale and receipt numbers. Incremented inside the same transaction as the record it numbers.
model NumberSequence {
  key   String @id // e.g. "sale:NC", "receipt:NC"
  value Int

  @@map("number_sequences")
}

/// Fixed-window rate-limit counters shared by every app instance (login, uploads, OCR, comms).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}
